<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- dragtube://saved opens the saved videos window (sent by the extension on ⌥⇧Y) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>org.raiymbek.DragTube</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dragtube</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
